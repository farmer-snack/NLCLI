<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.ConfigDebugSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:controls2="clr-namespace:ClassIsland.Controls"
      xmlns:controls3="using:FluentAvalonia.UI.Controls"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      d:DataContext="{d:DesignInstance local:ConfigDebugSettingsPage}"
      Loaded="ConfigDebugSettingsPage_OnLoaded"
      Unloaded="ConfigDebugSettingsPage_OnUnloaded">

    <!--
        整页放在一个 ScrollViewer 里：变量列表改成 ItemsControl，不再有内部滚动区，
        鼠标滚轮和触摸拖动都统一滚动整个页面，不会出现「只有一小块能滑」的情况。
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="settings-container animated-intro" Spacing="8" Margin="0 0 0 24">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <controls1:IconText Glyph="&#xE943;" Text="变量调试" VerticalAlignment="Center" />
                <Border Background="#1A4C8BF5" CornerRadius="4" Padding="7 2" VerticalAlignment="Center">
                    <TextBlock Text="该页面由 farmer-snack/NLCLI 维护" FontSize="11" Opacity="0.85" />
                </Border>
            </StackPanel>

            <!--
                说明、改动记录、官方调试入口、更新编译与原生库检查全部收进这一个折叠面板，
                默认收起，不占页面底部的位置，把首屏高度留给变量列表。
            -->
            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xE946;}"
                                          Header="说明与调试入口"
                                          Description="改动记录、使用说明、官方调试页面开关、更新编译与原生库检查">
                <controls3:FASettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="直接读写 Settings.json 中的每一个配置变量。这里的修改会立即写入配置文件，部分设置需要重启应用后才会生效。"
                                   Classes="l-instructive" FontSize="12" Opacity="0.75"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="完整改动记录：每次改动都写进 fixxed.txt，可点开查看；下面两个地址内容相同，任选其一。"
                                   Classes="l-instructive" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="主源：" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                            <HyperlinkButton Content="GitHub · fixxed.txt" FontSize="11"
                                             Tag="https://github.com/farmer-snack/NLCLI/blob/develop/v2/misha-alpha/fixxed.txt"
                                             Click="HyperlinkOpenLink_OnClick"
                                             ToolTip.Tip="打开 GitHub 上的 fixxed.txt" />
                            <TextBlock Text="备用源：" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="14 0 0 0" />
                            <HyperlinkButton Content="CDN · jsDelivr" FontSize="11"
                                             Tag="https://cdn.jsdelivr.net/gh/farmer-snack/NLCLI@develop/v2/misha-alpha/fixxed.txt"
                                             Click="HyperlinkOpenLink_OnClick"
                                             ToolTip.Tip="GitHub 打不开时用这个 CDN 备用源" />
                        </WrapPanel>
                        <SelectableTextBlock Text="https://github.com/farmer-snack/NLCLI/blob/develop/v2/misha-alpha/fixxed.txt"
                                             FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="https://cdn.jsdelivr.net/gh/farmer-snack/NLCLI@develop/v2/misha-alpha/fixxed.txt"
                                             FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                        <controls3:FAInfoBar Severity="Warning"
                                             IsOpen="True"
                                             IsClosable="False"
                                             Message="这是调试工具。修改不熟悉的变量可能导致应用行为异常，请谨慎操作。" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="显示官方「调试」入口" FontSize="13" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ViewModel.SettingsService.Settings.IsDebugOptionsEnabled, Mode=TwoWay}"
                                          ToolTip.Tip="控制官方的「调试」入口。本页不受此开关影响，始终显示。" />
                        </Grid>

                        <!-- 拉取更新并编译运行（折叠在这里，不占页面底部） -->
                        <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xE895;}"
                                                      Header="拉取更新并编译运行"
                                                      Description="从当前 Git 仓库拉取最新提交，自动补齐子模块、安装缺失的 Git 与 .NET SDK。「开始更新并编译」会编译后重启到新版本；「打包编译产物」直接调用 dotnet publish（参数同仓库 build-publish.bat，可选自包含/非自包含），先清理旧 out 目录、打包后删除 .pdb 并生成 out.zip 压缩包。可勾选「网络加速」优先走镜像。仅在从源码目录运行时可用。">
                            <controls3:FASettingsExpanderItem>
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding ViewModel.RemoteBranches}"
                                                  SelectedItem="{Binding ViewModel.SettingsService.Settings.DevelopmentUpdateBranch, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="分支列表从仓库自动探测；也可手动输入任意分支名。" />
                                        <Button Grid.Column="1"
                                                Content="刷新分支"
                                                Click="ButtonRefreshRemoteBranches_OnClick"
                                                IsEnabled="{Binding !ViewModel.IsRemoteBranchesLoading}"
                                                ToolTip.Tip="重新从远程仓库探测可用分支" />
                                        <Button Grid.Column="2"
                                                Content="开始更新并编译"
                                                Classes="accent"
                                                Click="ButtonDevelopmentUpdate_OnClick"
                                                IsEnabled="{Binding !ViewModel.IsAnyBuildRunning}" />
                                        <Button Grid.Column="3"
                                                Content="打包编译产物"
                                                Click="ButtonPublish_OnClick"
                                                IsEnabled="{Binding !ViewModel.IsAnyBuildRunning}"
                                                ToolTip.Tip="按仓库 build-publish.bat 的参数调用 dotnet publish：先删除旧 out 目录、打包后清理 .pdb，最后生成并打开 out.zip。" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox Content="打包为自包含（含 .NET 运行时，体积较大）"
                                                  IsChecked="{Binding ViewModel.SettingsService.Settings.DevelopmentPublishSelfContained, Mode=TwoWay}"
                                                  ToolTip.Tip="勾选：self-contained，产物自带运行时可独立运行（默认）；取消：依赖目标机器已安装 .NET 运行时。" />
                                        <CheckBox Content="网络加速（优先镜像）"
                                                  IsChecked="{Binding ViewModel.SettingsService.Settings.DevelopmentUpdatePreferMirror, Mode=TwoWay}"
                                                  ToolTip.Tip="勾选后跳过官方直连、先依次尝试加速镜像；镜像全部失败再回退直连。不勾选则维持直连优先。" />
                                        <Button Content="取消"
                                                Click="ButtonCancelDevelopmentUpdate_OnClick"
                                                IsEnabled="{Binding ViewModel.IsAnyBuildRunning}" />
                                    </StackPanel>
                                    <ProgressBar IsIndeterminate="True"
                                                 IsVisible="{Binding ViewModel.IsAnyBuildRunning}" />
                                    <TextBlock Text="{Binding ViewModel.DevelopmentUpdateStatus}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="DevelopmentUpdateLogBox"
                                             Text="{Binding ViewModel.DevelopmentUpdateLog}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             Height="180"
                                             FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                                             IsVisible="{Binding ViewModel.HasDevelopmentUpdateLog}" />
                                </StackPanel>
                            </controls3:FASettingsExpanderItem>
                        </controls3:FASettingsExpander>

                        <!-- 原生库依赖检查（同样折叠在这里） -->
                        <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xE897;}"
                                                      Header="原生库依赖检查"
                                                      Description="扫描 runtimes 目录下的原生库，检查它们依赖的系统运行库是否齐全。缺失的 VC++ 运行库会自动从微软下载安装，缺失的 NuGet 原生库会自动从 nuget.org 还原。">
                            <controls3:FASettingsExpanderItem>
                                <StackPanel Spacing="8">
                                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsNativeDependencyAutoRepairEnabled, Mode=TwoWay}"
                                                  OnContent="启动时自动检查并修复"
                                                  OffContent="启动时自动检查并修复"
                                                  ToolTip.Tip="关闭后启动时不再检查，仍可在这里手动检查和修复" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="立即检查"
                                                Click="ButtonCheckNativeDependencies_OnClick"
                                                IsEnabled="{Binding !ViewModel.IsNativeDependencyBusy}" />
                                        <Button Content="自动修复"
                                                Classes="accent"
                                                Click="ButtonRepairNativeDependencies_OnClick"
                                                IsEnabled="{Binding !ViewModel.IsNativeDependencyBusy}" />
                                        <Button Content="打开 runtimes 目录"
                                                Click="ButtonOpenRuntimesDirectory_OnClick" />
                                    </StackPanel>
                                    <ProgressBar IsIndeterminate="True"
                                                 IsVisible="{Binding ViewModel.IsNativeDependencyBusy}" />
                                    <TextBlock Text="{Binding ViewModel.NativeDependencyStatus}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <ScrollViewer MaxHeight="200"
                                                  VerticalScrollBarVisibility="Auto"
                                                  IsVisible="{Binding ViewModel.HasNativeDependencyIssues}">
                                        <ItemsControl ItemsSource="{Binding ViewModel.NativeDependencyIssues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#14FF6B6B" CornerRadius="4" Padding="8 4" Margin="0 2">
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </controls3:FASettingsExpanderItem>
                        </controls3:FASettingsExpander>
                    </StackPanel>
                </controls3:FASettingsExpanderItem>
            </controls3:FASettingsExpander>

            <!-- 搜索与筛选（固定在列表上方，不参与折叠） -->
            <Grid ColumnDefinitions="*,170,Auto,Auto" ColumnSpacing="8" Margin="0 4 0 0">
                <TextBox Grid.Column="0"
                         Watermark="搜索变量名（例如 Notification、Weather、Speech）…"
                         Text="{Binding ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ViewModel.TypeFilters}"
                          SelectedItem="{Binding ViewModel.SelectedTypeFilter, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <ToggleSwitch Grid.Column="2"
                              OnContent="只读"
                              OffContent="可写"
                              IsChecked="{Binding ViewModel.ShowReadOnly, Mode=TwoWay}"
                              ToolTip.Tip="是否显示只读变量（集合、复杂对象等）" />
                <Button Grid.Column="3"
                        Content="重启应用"
                        Click="ButtonRestart_OnClick"
                        ToolTip.Tip="部分变量需要重启应用后才会生效" />
            </Grid>

            <TextBlock Text="{Binding ViewModel.StatusText}"
                       FontSize="12"
                       Opacity="0.7" />

            <!-- 变量列表：跟随页面滚动，不再限制成一小块固定区域 -->
            <ItemsControl ItemsSource="{Binding ViewModel.Variables}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#18000000"
                                BorderThickness="0 0 0 1"
                                Padding="2 7">
                            <Grid ColumnDefinitions="260,*,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding TypeName}" FontSize="11" Opacity="0.6" />
                                        <TextBlock Text="只读" FontSize="11" Opacity="0.6"
                                                   IsVisible="{Binding !CanWrite}" />
                                        <TextBlock Text="不写入配置文件" FontSize="11"
                                                   Foreground="#FFE8A33D"
                                                   IsVisible="{Binding !IsPersisted}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <controls2:SettingsVariableEditor />
                                    <TextBlock Text="{Binding LastError}"
                                               FontSize="11"
                                               Foreground="#FFFF6B6B"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Theme="{StaticResource TransparentButton}"
                                        ToolTip.Tip="恢复默认值"
                                        Click="ButtonResetVariable_OnClick">
                                    <controls1:FluentIcon Glyph="&#xE4CC;" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
