<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.WeatherDetailSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:controls3="using:FluentAvalonia.UI.Controls"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:WeatherDetailSettingsPage}"
      Loaded="WeatherDetailSettingsPage_OnLoaded">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <controls1:IconText Glyph="&#xF464;" Text="天气详情" Margin="0 0 0 4" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 0 12">
                <Border Background="#1A4C8BF5" CornerRadius="4" Padding="7 2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.MaintainerText}" FontSize="11" Opacity="0.85" />
                </Border>
                <TextBlock Text="数据来自 Open-Meteo，与「天气」页的小米天气互不影响。"
                           Classes="l-instructive" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            </StackPanel>

            <Border CornerRadius="16" Padding="20" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FF1F4E79" Offset="0" />
                        <GradientStop Color="#FF3A2E5C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding ViewModel.CityName}"
                                       Foreground="White" Opacity="0.85" FontSize="15" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ViewModel.OmCurrentTemp}" Foreground="White"
                                           FontSize="46" FontWeight="SemiBold" />
                                <TextBlock Text="°C" Foreground="White" FontSize="18"
                                           VerticalAlignment="Bottom" Margin="0 0 0 10" Opacity="0.85" />
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.OmCurrentText}" Foreground="White" FontSize="15" />
                            <TextBlock Text="{Binding ViewModel.OmCurrentDetail}" Foreground="White"
                                       Opacity="0.75" FontSize="12" Margin="0 4 0 0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ViewModel.OmCurrentEmoji}" FontSize="54"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding ViewModel.OpenMeteoError}" Foreground="#FFFFB4B4" FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ViewModel.OpenMeteoError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- 顶部常用指标 -->
                    <ItemsControl ItemsSource="{Binding ViewModel.OmMetrics}"
                                  IsVisible="{Binding !!ViewModel.OmMetrics.Count}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22FFFFFF" CornerRadius="8" Padding="10 8" Margin="3">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11" />
                                        <TextBlock Text="{Binding Value}" Foreground="White" FontSize="14"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 当前时刻的全部字段 -->
                    <Expander IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="#14FFFFFF"
                              CornerRadius="10">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="当前全部数据" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ViewModel.OmFieldCountText}" Foreground="#99FFFFFF"
                                           FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding ViewModel.OmCurrentAll}" Margin="4 2 4 8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1" Margin="4 4">
                                        <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11" />
                                        <TextBlock Text="{Binding Value}" Foreground="White" FontSize="12"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Value}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- 每 15 分钟：未来 24 小时，点一条看该时段全部数据 -->
                    <StackPanel Spacing="8" IsVisible="{Binding !!ViewModel.OmMinutes.Count}">
                        <TextBlock Text="每 15 分钟 · 未来 24 小时（左右滑动，点一条看全部数据）"
                                   Foreground="White" Opacity="0.8" FontSize="13" FontWeight="SemiBold" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding ViewModel.OmMinutes}"
                                     SelectedItem="{Binding ViewModel.SelectedMinute, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="Background" Value="#14FFFFFF" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#40FFFFFF" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Margin="5 5" Width="54" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Foreground="White" Opacity="0.8"
                                                       FontSize="11" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Temp}" Foreground="White" FontSize="12"
                                                       FontWeight="Medium" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Precip}" Foreground="#FFBFE3FF" FontSize="10"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <Border Background="#22FFFFFF" CornerRadius="10" Padding="12"
                                IsVisible="{Binding ViewModel.SelectedMinute, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ViewModel.SelectedMinute.Label, StringFormat='{}{0} 的全部数据'}"
                                           Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding ViewModel.SelectedMinute.Detail}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="1" Margin="3 3">
                                                <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11" />
                                                <TextBlock Text="{Binding Value}" Foreground="White" FontSize="12"
                                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Value}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 空气质量：常用项 + 全部字段 -->
                    <StackPanel Spacing="8" IsVisible="{Binding !!ViewModel.OmAqi.Count}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="空气质量" Foreground="White" Opacity="0.8" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#33FFFFFF" CornerRadius="6" Padding="8 1">
                                <TextBlock Text="{Binding ViewModel.OmAqiLevel}" Foreground="White"
                                           FontSize="11" FontWeight="Medium" />
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ViewModel.OmAqi}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1" Margin="3 4">
                                        <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11" />
                                        <TextBlock Text="{Binding Value}" Foreground="White" FontSize="13"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander IsExpanded="False"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Background="#14FFFFFF"
                                  CornerRadius="10">
                            <Expander.Header>
                                <TextBlock Text="全部空气质量字段（含分项 AQI、沙尘、花粉等）"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding ViewModel.OmAqiAll}" Margin="4 2 4 8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Margin="4 4">
                                            <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11" />
                                            <TextBlock Text="{Binding Value}" Foreground="White" FontSize="12"
                                                       FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>

                    <!-- 未来 16 天：今天默认展开；点一天看该日全部字段，再点一个小时看该小时全部字段 -->
                    <StackPanel Spacing="6" IsVisible="{Binding !!ViewModel.OmDays.Count}">
                        <TextBlock Text="未来 16 天（今天默认展开；点一天看全天数据，再点一个小时看该小时全部数据）"
                                   Foreground="White" Opacity="0.8" FontSize="13" FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="66,26,108,*,88,42" ColumnSpacing="6" Margin="4 0 4 2">
                            <TextBlock Text="日期" Foreground="#99FFFFFF" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="温度" Foreground="#99FFFFFF" FontSize="11" />
                            <TextBlock Grid.Column="3" Text="降水" Foreground="#99FFFFFF" FontSize="11" />
                            <TextBlock Grid.Column="4" Text="风" Foreground="#99FFFFFF" FontSize="11" />
                            <TextBlock Grid.Column="5" Text="UV" Foreground="#99FFFFFF" FontSize="11" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ViewModel.OmDays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Margin="0 1"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="66,26,108,*,88,42" ColumnSpacing="6" Margin="0 2">
                                                <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="13"
                                                               FontWeight="Medium" />
                                                    <TextBlock Text="{Binding DateText}" Foreground="#99FFFFFF"
                                                               FontSize="10" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Emoji}" FontSize="16"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding TempRange}" Foreground="White"
                                                           FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Precip}" Foreground="#FFBFE3FF"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding Wind}" Foreground="#CCFFFFFF"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="5" Text="{Binding Uv}" Foreground="#CCFFFFFF"
                                                           FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </Expander.Header>

                                        <StackPanel Spacing="10" Margin="0 6 0 10">
                                            <TextBlock Text="{Binding Summary}" Foreground="#CCFFFFFF" FontSize="12" />

                                            <TextBlock Text="这一天的全部数据" Foreground="#CCFFFFFF" FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Detail}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="5" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="1" Margin="3 3">
                                                            <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11" />
                                                            <TextBlock Text="{Binding Value}" Foreground="White" FontSize="13"
                                                                       FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Value}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding HourCountText, StringFormat='这一天的逐小时（{0}，点一个小时看详细数据）'}"
                                                           Foreground="#CCFFFFFF" FontSize="12" FontWeight="SemiBold" />
                                                <ListBox ItemsSource="{Binding Hours}"
                                                         SelectedItem="{Binding SelectedHour, Mode=TwoWay}"
                                                         Background="Transparent" BorderThickness="0" Padding="0">
                                                    <ListBox.Styles>
                                                        <Style Selector="ListBoxItem">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="Margin" Value="2" />
                                                            <Setter Property="Background" Value="#14FFFFFF" />
                                                            <Setter Property="CornerRadius" Value="8" />
                                                        </Style>
                                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                            <Setter Property="Background" Value="#40FFFFFF" />
                                                        </Style>
                                                    </ListBox.Styles>
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="8" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Spacing="2" Margin="4 5" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" Foreground="White" Opacity="0.8"
                                                                           FontSize="11" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding Emoji}" FontSize="18"
                                                                           HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding Temp}" Foreground="White" FontSize="12"
                                                                           FontWeight="Medium" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding Precip}" Foreground="#FFBFE3FF" FontSize="10"
                                                                           HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>

                                            <Border Background="#22FFFFFF" CornerRadius="10" Padding="12"
                                                    IsVisible="{Binding SelectedHour, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding SelectedHour.Label, StringFormat='{}{0} 的全部数据'}"
                                                               Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                    <ItemsControl ItemsSource="{Binding SelectedHour.Detail}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="5" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Spacing="1" Margin="2 3">
                                                                    <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11" />
                                                                    <TextBlock Text="{Binding Value}" Foreground="White" FontSize="13"
                                                                               FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{Binding Value}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 底部：刷新状态 + 剩余请求机会 -->
                    <Grid RowDefinitions="Auto,Auto" Margin="0 4 0 0">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <controls3:FAProgressRing Width="16" Height="16" IsIndeterminate="True"
                                                      IsVisible="{Binding ViewModel.IsOpenMeteoLoading}" />
                            <TextBlock Text="{Binding ViewModel.OmUpdatedAt}" Foreground="White" Opacity="0.55"
                                       FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="·" Foreground="White" Opacity="0.35" FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ViewModel.OmCacheStatus}" Foreground="White" Opacity="0.55"
                                       FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0 6 0 0">
                            <TextBlock Text="{Binding ViewModel.OmQuotaText}" Foreground="#B3FFFFFF"
                                       FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="立即刷新" Padding="10 4" FontSize="11"
                                    Click="ButtonRefresh_OnClick"
                                    ToolTip.Tip="忽略 30 分钟缓存，立即向 Open-Meteo 请求一次（会消耗 2 次请求机会）" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
