<UserControl x:Class="ClassIsland.Controls.NotificationProviders.WeatherHourlyForecastNotificationProvider"
             xmlns="https://github.com/avaloniaui"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClassIsland.Controls.NotificationProviders"
             xmlns:controls="clr-namespace:ClassIsland.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:WeatherHourlyForecastNotificationProvider}}">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsVisible="{Binding IsOverlay}">
            <ci:LucideIcon Glyph="&#xe0ff;" VerticalAlignment="Center"
                           FontSize="20" FontWeight="Medium"
                           Height="20" Width="20"/>
            <TextBlock Text="天气预报" FontSize="{DynamicResource MainWindowEmphasizedFontSize}" Margin="8 0" FontWeight="Bold"/>
            <controls:WeatherPackIconControl Code="{Binding Info.ForecastDaily.Weather.Value[0].To}" VerticalAlignment="Center"
                                             Height="22" AllowColor="False" />
        </StackPanel>
        <Grid HorizontalAlignment="Center" IsVisible="{Binding !IsOverlay}">
            <!-- 12 小时固定列宽 + 可横向滚动：窗口再窄也不会把文字压扁 -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="0"
                          Margin="8 0">
                <ItemsControl ItemsSource="{Binding Hours}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Spacing="3" Width="50"
                                        HorizontalAlignment="Center" Margin="1 0">
                                <TextBlock Classes="l-secondary" Text="{Binding Label}" FontSize="12"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <controls:WeatherPackIconControl Code="{Binding WeatherCode}"
                                                                 Height="20"
                                                                 HorizontalAlignment="Center"
                                                                 Margin="0 0 0 1"/>
                                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Temperature}"/><Run Text="℃"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
