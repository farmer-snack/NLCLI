<UserControl x:Class="ClassIsland.Controls.NotificationProviders.WeatherForecastNotificationProvider"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClassIsland.Controls.NotificationProviders"
             xmlns:controls="clr-namespace:ClassIsland.Controls"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:WeatherForecastNotificationProvider}}">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsVisible="{Binding IsOverlay}">
            <ci:LucideIcon Glyph="&#xe0ff;" VerticalAlignment="Center"
                           FontSize="20" FontWeight="Medium"
                           Height="20" Width="20"/>
            <TextBlock Text="天气预报" FontSize="{DynamicResource MainWindowEmphasizedFontSize}" Margin="8 0" FontWeight="Bold"/>
            <controls:WeatherPackIconControl Code="{Binding Info.ForecastDaily.Weather.Value[0].To}"
                                             VerticalAlignment="Center"
                                             Height="22" AllowColor="False"/>
        </StackPanel>
        <Grid HorizontalAlignment="Center" IsVisible="{Binding !IsOverlay}">
            <ItemsControl ItemsSource="{Binding Days}" Margin="12 0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Spacing="2"
                                    HorizontalAlignment="Center" Margin="4 0">
                            <TextBlock Text="{Binding Label}" Classes="l-secondary" FontWeight="Bold"
                                       FontSize="13" HorizontalAlignment="Center"/>
                            <controls:WeatherRangePackIconControl Value="{Binding Weather}"
                                                                  Height="24"
                                                                  HorizontalAlignment="Center"
                                                                  Margin="0 0 0 2"/>
                            <TextBlock FontWeight="Medium" FontSize="13" HorizontalAlignment="Center">
                                <Run Text="{Binding TempFrom}"/><Run Text="~"/><Run Text="{Binding TempTo}"/><Run Text="℃"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
